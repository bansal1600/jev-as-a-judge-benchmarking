# LangSmith tracing -- get a free key at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=jev-as-a-judge
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Local Ollama models (swap the judge for a bigger model anytime)
AGENT_MODEL=gemma4-judge:latest
JUDGE_MODEL=gemma4-judge:latest

# OpenAI second judge
OPENAI_API_KEY=sk-proj-your_key_here
OPENAI_JUDGE_MODEL=gpt-4o-mini

# TypeSafe Jev judge
TYPESAFE_API_KEY=your_typesafe_key_here
JEV_MODEL=jev-latest
